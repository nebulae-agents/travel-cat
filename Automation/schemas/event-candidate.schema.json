{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelcat.local/schemas/event-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "tripId", "previousEventId", "occurredAt", "phase", "summary", "mood", "continuityReferences", "postcard"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "previousEventId": {"type": ["string", "null"], "format": "uuid"},
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "$comment": "Travel Cat supports the Foundation Date-representable RFC 3339 subset with years 0001 through 9999: T/t and Z/z are equivalent; year 0000 and leap-second 60 are intentionally rejected. Gregorian calendar validity is enforced at runtime."
    },
    "phase": {"enum": ["preparing", "transit", "exploring", "postcardReady", "returning", "resting"]},
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["country", "city", "place"],
      "properties": {
        "country": {"type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
        "city": {"type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
        "place": {"type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"}
      }
    },
    "transport": {"type": ["string", "null"], "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
    "summary": {"type": "string", "minLength": 20, "maxLength": 240, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "label", "quote"],
      "properties": {
        "level": {"type": "integer", "minimum": -2, "maximum": 2},
        "label": {"type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
        "quote": {"type": "string", "minLength": 4, "maxLength": 32, "pattern": "^(?![^]*[\\u000A\\u000D])(?![\\u0009\\u000A\\u000D\\u0020])(?![^]*[\\u0009\\u0020]$)"}
      }
    },
    "continuityReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"}
    },
    "openHook": {"type": ["string", "null"], "minLength": 1, "maxLength": 120, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
    "consumedItemId": {"type": ["string", "null"], "minLength": 1, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"},
    "postcard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "scenePrompt"],
      "properties": {
        "required": {"type": "boolean"},
        "scenePrompt": {"type": ["string", "null"], "minLength": 1, "maxLength": 500, "pattern": "^(?:\\S|\\S(?:.|\\n)*\\S)$"}
      }
    }
  }
}
