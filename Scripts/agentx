#!/usr/bin/env python3
"""Query or stop a run through a local AgentX pilot service."""
import argparse
import http.client
import json
import os
import re
import stat
import sys
import uuid
from pathlib import Path


def identifier(value):
    if not re.fullmatch(r"[a-zA-Z0-9_-]{1,100}", value):
        raise argparse.ArgumentTypeError("expected an AgentX identifier")
    return value


def idempotency_key(value):
    if not re.fullmatch(r"[a-zA-Z0-9_.:-]{1,128}", value):
        raise argparse.ArgumentTypeError("expected a valid stop idempotency key")
    return value


def endpoint(root):
    info = root.stat()
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("expected a private pilot root owned by the current user")
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(root / ".agentxd-endpoint.json", flags), "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError("invalid service endpoint permissions")
        data = json.loads(stream.read(4097))
    if not isinstance(data, dict):
        raise ValueError("invalid service endpoint")
    port, token = data.get("port"), data.get("token")
    if type(port) is not int or not 0 < port < 65536 or not isinstance(token, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,256}", token):
        raise ValueError("invalid service endpoint")
    return port, token


def run(args):
    port, token = endpoint(args.root)
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=30)
    path = "/v1/apps/" + args.app + "/runs"
    if args.operation != "list":
        path += "/" + args.run
    if args.operation == "events":
        if args.after < 0:
            raise ValueError("expected a nonnegative event cursor")
        path += "/events?after=" + str(args.after)
    if args.operation == "audit":
        path += "/audit"
    headers = {"Authorization": "Bearer " + token, "Accept": "application/json"}
    try:
        if args.operation == "stop":
            headers.update({"Content-Type": "application/json", "Idempotency-Key": args.idempotency_key or str(uuid.uuid4())})
            connection.request("POST", path + "/stop", body=b"{}", headers=headers)
        else:
            connection.request("GET", path, headers=headers)
        response = connection.getresponse()
        if args.operation == "events" and response.status == 409:
            raise ValueError("cursor unavailable; read the run snapshot and resume from its revision")
        if response.status not in (200, 202):
            raise ValueError("service rejected request (HTTP %d)" % response.status)
        data = json.load(response)
    finally:
        connection.close()
    if args.operation == "audit":
        if not isinstance(data, dict) or data.get("runId") != args.run or data.get("appID") != args.app:
            raise ValueError("invalid audit response from service")
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    if args.operation == "events":
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    records = data if args.operation == "list" else [data]
    if not isinstance(records, list) or not all(isinstance(record, dict) and record.get("appID") == args.app for record in records):
        raise ValueError("invalid run response from service")
    if args.operation != "list" and data.get("id") != args.run:
        raise ValueError("service returned another run")
    print(json.dumps(data, ensure_ascii=False, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=os.environ.get("AGENTX_ROOT"), help="pilot root (default: AGENTX_ROOT)")
    commands = parser.add_subparsers(dest="command", required=True)
    ops = commands.add_parser("run").add_subparsers(dest="operation", required=True)
    for name in ("list", "show", "stop", "events", "audit"):
        op = ops.add_parser(name)
        op.add_argument("--app", required=True, type=identifier)
        if name != "list":
            op.add_argument("--run", required=True, type=identifier)
        if name == "events":
            op.add_argument("--after", required=True, type=int)
        if name == "stop":
            op.add_argument("--idempotency-key", type=idempotency_key, help="stable key for retrying the same stop request")
    args = parser.parse_args()
    if args.root is None:
        parser.error("specify --root or set AGENTX_ROOT")
    try:
        run(args)
    except (OSError, KeyError, ValueError, http.client.HTTPException) as error:
        sys.exit("agentx: " + str(error))


if __name__ == "__main__":
    main()
