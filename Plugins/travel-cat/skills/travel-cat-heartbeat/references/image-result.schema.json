{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelcat.local/schemas/image-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "status", "attemptedAt", "attemptToken", "attemptCount", "publishedNarrativeHash"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "status": {"enum": ["ready", "failed", "rejected_identity"]},
    "attemptedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "$comment": "Foundation Date-representable RFC 3339 subset; runtime also enforces Gregorian calendar validity."
    },
    "relativePath": {"type": ["string", "null"]},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": {"type": "string", "pattern": "^postcards/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[a-z0-9][a-z0-9._-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "$comment": "Optional immutable presentation manifest. Omit for legacy results; only ready results may select a presentation."
    },
    "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "attemptToken": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 2},
    "publishedNarrativeHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
      "then": {
        "required": ["relativePath"],
        "properties": {
          "relativePath": {
            "type": "string",
            "pattern": "^postcards/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[a-z0-9][a-z0-9._-]*\\.(png|webp)$"
          }
        }
      },
      "else": {"properties": {"relativePath": {"type": "null"}}, "not": {"required": ["presentation"]}}
    }
  ]
}
